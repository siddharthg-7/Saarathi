# Saarathi OS Backend Environment Configuration Template
# Classifications: PUBLIC_CLIENT_CONFIG | SERVER_SECRET | SERVER_CONFIG

# [PUBLIC_CLIENT_CONFIG]
FIREBASE_PROJECT_ID=saarathi-331b4

# [SERVER_SECRET]
# Service account JSON or file path (At least one required for Firebase Admin in production)
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CREDENTIALS_JSON=

# AI Provider API Keys (Keep secret, never expose to client applications)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Supabase Long-Term Memory (pgvector)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# [SERVER_CONFIG]
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081
REDIS_URL=redis://localhost:6379/0
ADMIN_EMAILS=admin@saarathi.app
ADMIN_UIDS=admin-uid

