# ==========================================
# SAARATHI OS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# ------------------------------------------
# 1. FRONTEND / CLIENT ENVIRONMENT (Vite / Vercel)
# ------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id
VITE_API_URL=https://your-api.onrender.com

# ------------------------------------------
# 2. BACKEND API ENVIRONMENT (FastAPI / Render)
# ------------------------------------------
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Firebase Admin SDK (Server Secret)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# AI Engine Keys (Server Secrets)
GROQ_API_KEY=gsk_your_groq_api_key
GEMINI_API_KEY=AIzaSy_your_gemini_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key

# Supabase Vector Store
SUPABASE_URL=https://your_supabase_id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Redis / Celery Cache & Worker (Render Key-Value)
REDIS_URL=redis://default:password@your-redis-host:6379

# Admin Configuration
ADMIN_EMAILS=admin@saarathi.app
ADMIN_UIDS=admin-uid

