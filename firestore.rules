rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles security rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false; // User accounts cannot be deleted directly without admin review
    }

    // User settings security rules
    match /settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User devices subcollection
    match /devices/{userId}/user_devices/{deviceId} {
      allow read, write: if isOwner(userId);
    }

    // User sessions subcollection
    match /sessions/{userId}/user_sessions/{sessionId} {
      allow read, write: if isOwner(userId);
    }

    // Tasks collection security rules
    match /tasks/{taskId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
  }
}
