rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }

    // Ownership immutability: clients cannot reassign documents to another user
    function doesNotModifyOwnership(userId) {
      return (!('uid' in request.resource.data) || request.resource.data.uid == userId)
          && (!('userId' in request.resource.data) || request.resource.data.userId == userId);
    }

    // User profiles security rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && doesNotModifyOwnership(userId);
      allow update: if isOwner(userId) && doesNotModifyOwnership(userId);
      allow delete: if false; // Profile deletion must go through secure server deletion protocol

      // All per-user subcollections (tasks, projects, goals, telemetry, analytics, etc.)
      match /{document=**} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && doesNotModifyOwnership(userId);
        allow update: if isOwner(userId) && doesNotModifyOwnership(userId);
        allow delete: if isOwner(userId);
      }
    }

    // User settings security rules
    match /settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User devices subcollection
    match /devices/{userId}/user_devices/{deviceId} {
      allow read, write: if isOwner(userId);
    }

    // User sessions subcollection
    match /sessions/{userId}/user_sessions/{sessionId} {
      allow read, write: if isOwner(userId);
    }

    // Security Audit Logs: Immutable, server-written only, admin-readable
    match /audit_logs/{auditId} {
      allow read: if isAdmin();
      allow write: if false; // Normal clients cannot write or delete audit events
    }
  }
}
