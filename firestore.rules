rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles security rules
    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false; // User accounts cannot be deleted directly without admin review
    }

    // All data owned by a user lives in per-user subcollections
    // (tasks, projects, goals, ...). Scope every document under the
    // user's path to the owner so cross-user access is impossible.
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // User settings security rules
    match /settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // User devices subcollection
    match /devices/{userId}/user_devices/{deviceId} {
      allow read, write: if isOwner(userId);
    }

    // User sessions subcollection
    match /sessions/{userId}/user_sessions/{sessionId} {
      allow read, write: if isOwner(userId);
    }
  }
}
